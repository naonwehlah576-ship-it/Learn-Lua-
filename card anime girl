local function doCollectObjects()
    pcall(function()
        local objects = CollectionService:GetTagged("CollectableObject")
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        for _, obj in ipairs(objects) do
            if Remotes:FindFirstChild("CollectCollectableObject") then
                pcall(function() Remotes.CollectCollectableObject:FireServer(obj) end)
                pcall(function() Remotes.CollectCollectableObject:FireServer(obj.Name) end)
            end
            
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("ProximityPrompt") then
                    triggerPrompt(desc)
                end
            end
            
            if hrp and typeof(firetouchinterest) == "function" then
                local part = (obj:IsA("BasePart") and obj) or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    pcall(function()
                        firetouchinterest(hrp, part, 0)
                        task.wait(0.01)
                        firetouchinterest(hrp, part, 1)
                    end)
                end
            end
        end
    end)
end

