-- TAB 4: ⚡ PLAYER & TELEPORT
local playerPage = createTab("Player", "⚡", 4)

createToggle(playerPage, "👻 Noclip (Tembus Tembok)", Config.Noclip, function(val)
    Config.Noclip = val
end)

createToggle(playerPage, "🚀 Infinite Jump", Config.InfiniteJump, function(val)
    Config.InfiniteJump = val
end)

createToggle(playerPage, "🏃 Speed Boost (Speed: 50)", Config.WalkSpeedEnabled, function(val)
    Config.WalkSpeedEnabled = val
    Config.WalkSpeedValue = val and 50 or 16
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = Config.WalkSpeedValue end
end)

createButton(playerPage, "📍 Teleport: Conveyor Collect Part", Color3.fromRGB(45, 90, 160), function()
    local myPlot = getMyPlot()
    local collectPart = myPlot and myPlot:FindFirstChild("Systems") 
        and myPlot.Systems:FindFirstChild("TycoonConveyor") 
        and myPlot.Systems.TycoonConveyor:FindFirstChild("CollectPart")
    if collectPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = collectPart.CFrame + Vector3.new(0, 3, 0)
    end
end)

createButton(playerPage, "📍 Teleport: Sell NPC", Color3.fromRGB(50, 130, 80), function()
    local myPlot = getMyPlot()
    local sellZone = myPlot and myPlot:FindFirstChild("Systems") 
        and myPlot.Systems:FindFirstChild("Zones") 
        and myPlot.Systems.Zones:FindFirstChild("sell npc")
    local targetPart = sellZone and (sellZone:FindFirstChildWhichIsA("BasePart") or sellZone.PrimaryPart)
    if targetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
    end
end)

createButton(playerPage, "📍 Teleport: Polisher Machine", Color3.fromRGB(140, 70, 160), function()
    local myPlot = getMyPlot()
    local polisher = myPlot and myPlot:FindFirstChild("Systems") 
        and myPlot.Systems:FindFirstChild("PolisherModel")
        and myPlot.Systems.PolisherModel:FindFirstChild("PhysicalModel")
        and myPlot.Systems.PolisherModel.PhysicalModel:FindFirstChild("CollectPart")
    if polisher and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = polisher.CFrame + Vector3.new(0, 3, 0)
    end
end)

