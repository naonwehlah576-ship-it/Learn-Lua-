-- [CARDS] Card Rolling & Filter Buy
local function getRolledRarity()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local newCardsGui = pGui:FindFirstChild("NewCardsGui")
        if newCardsGui and newCardsGui.Enabled ~= false then
            for _, desc in ipairs(newCardsGui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                    local tLower = desc.Text:lower():gsub("%s+", "")
                    for rName, tier in pairs(RarityTiers) do
                        if tLower == rName or tLower:find(rName) then
                            return rName, tier
                        end
                    end
                end
            end
        end

        local autoBuyGui = pGui:FindFirstChild("AutoBuyGui")
        if autoBuyGui and autoBuyGui.Enabled ~= false then
            for _, desc in ipairs(autoBuyGui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                    local tLower = desc.Text:lower():gsub("%s+", "")
                    for rName, tier in pairs(RarityTiers) do
                        if tLower == rName then
                            return rName, tier
                        end
                    end
                end
            end
        end
    end

    local myPlot = getMyPlot()
    if myPlot then
        local conveyor = myPlot:FindFirstChild("Systems") 
            and myPlot.Systems:FindFirstChild("TycoonConveyor")
        if conveyor then
            for _, desc in ipairs(conveyor:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                    local tLower = desc.Text:lower():gsub("%s+", "")
                    for rName, tier in pairs(RarityTiers) do
                        if tLower == rName then
                            return rName, tier
                        end
                    end
                end
            end
        end
    end

    return nil, 0
end

local function doRollCard()
    if not Config.AutoRoll then return end
    
    -- Request Roll
    pcall(function()
        if Remotes:FindFirstChild("RequestConveyorRoll") then
            Remotes.RequestConveyorRoll:FireServer()
        end
    end)
    
    if Config.AutoRollFilterEnabled then
        task.wait(0.35)
        local detectedRarity, detectedTier = getRolledRarity()
        local targetTier = Config.MinRarityIndex or 4
        
        if detectedRarity and detectedTier > 0 then
            if detectedTier >= targetTier then
                -- Sesuai atau lebih tinggi dari target filter -> BUY!
                pcall(function()
                    if Remotes:FindFirstChild("PurchaseConveyorRoll") then
                        Remotes.PurchaseConveyorRoll:FireServer()
                    end
                end)
                print(string.format("✅ [Auto Roll] Kartu %s (Tier %d) Cocok! Membeli kartu...", detectedRarity:upper(), detectedTier))
            else
                -- Tidak sesuai target -> AUTO OFF AUTO ROLL!
                Config.AutoRoll = false
                saveConfig()
                if toggleRefs["AutoRoll"] then
                    toggleRefs["AutoRoll"].UpdateUI(false)
                end
                print(string.format("⚠️ [Auto Roll] Kartu: %s (Di bawah target %s). Auto Roll dimatikan!", 
                    detectedRarity:upper(), RarityOrder[targetTier] or "Target"))
            end
        else
            -- Jika belum terdeteksi dari GUI, eksekusi purchase sebagai default roll
            pcall(function()
                if Remotes:FindFirstChild("PurchaseConveyorRoll") then
                    Remotes.PurchaseConveyorRoll:FireServer()
                end
            end)
        end
    else
        -- Filter mati, roll & buy terus menerus
        pcall(function()
            if Remotes:FindFirstChild("PurchaseConveyorRoll") then
                Remotes.PurchaseConveyorRoll:FireServer()
            end
        end)
    end
end

