-- [REWARDS & VARIANT TOKEN TELEPORT COLLECTOR]
local function findActiveVariantToken()
    local spawnsFolder = Workspace:FindFirstChild("Systems") and Workspace.Systems:FindFirstChild("VariantTokenSpawns")
    if spawnsFolder then
        for _, part in ipairs(spawnsFolder:GetChildren()) do
            if part:GetAttribute("Occupied") == true or #part:GetChildren() > 0 then
                return part
            end
        end
    end

    for _, obj in ipairs(CollectionService:GetTagged("VariantTokenSpawn")) do
        if obj:GetAttribute("Occupied") == true or #obj:GetChildren() > 0 then
            return obj
        end
    end

    return nil
end

local isCollectingToken = false
local function collectVariantToken(targetObj)
    if isCollectingToken then return end
    isCollectingToken = true

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetObj then 
        isCollectingToken = false
        return 
    end

    local targetPart = targetObj:IsA("BasePart") and targetObj or targetObj:FindFirstChildWhichIsA("BasePart")
    if not targetPart then 
        isCollectingToken = false
        return 
    end

    local originalCFrame = hrp.CFrame
    print("🔮 [Variant Token] Menemukan token di: " .. targetObj.Name .. "! Teleport ke token...")

    -- 1. Teleport ke lokasi token
    hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3.5, 0)
    task.wait(0.35)

    -- 2. Simulasi sentuhan fisik (firetouchinterest)
    if typeof(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(hrp, targetPart, 0)
            task.wait(0.02)
            firetouchinterest(hrp, targetPart, 1)
        end)
    end

    -- 3. Trigger ProximityPrompt jika ada
    for _, desc in ipairs(targetObj:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            triggerPrompt(desc)
        end
    end

    -- 4. Tembak Remote Collect & Found
    if Remotes:FindFirstChild("VariantTokenFound") then
        pcall(function() Remotes.VariantTokenFound:FireServer(targetObj) end)
        pcall(function() Remotes.VariantTokenFound:FireServer(targetObj.Name) end)
    end
    if Remotes:FindFirstChild("CollectVariantTokenSpawn") then
        pcall(function() Remotes.CollectVariantTokenSpawn:FireServer(targetObj) end)
        pcall(function() Remotes.CollectVariantTokenSpawn:FireServer(targetObj.Name) end)
    end

    task.wait(0.4)

    -- 5. Teleport kembali ke posisi semula di base
    if hrp and originalCFrame then
        hrp.CFrame = originalCFrame
        print("✅ [Variant Token] Token diambil! Sukses kembali ke Base.")
    end

    isCollectingToken = false
end

