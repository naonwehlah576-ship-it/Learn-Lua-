local function doOpenDropperBoxes()
    local myPlot = getMyPlot()
    if not myPlot then return end
    
    pcall(function()
        -- 1. Coba RemoteFunction OpenBoxOnDropper
        if Remotes:FindFirstChild("OpenBoxOnDropper") then
            for i = 1, 10 do
                pcall(function()
                    Remotes.OpenBoxOnDropper:InvokeServer(i)
                end)
            end
        end
        
        -- 2. Trigger ProximityPrompt di Droppers
        local droppers = myPlot:FindFirstChild("Systems") 
            and myPlot.Systems:FindFirstChild("TycoonConveyor") 
            and myPlot.Systems.TycoonConveyor:FindFirstChild("Conveyors") 
            and myPlot.Systems.TycoonConveyor.Conveyors:FindFirstChild("Conveyor1") 
            and myPlot.Systems.TycoonConveyor.Conveyors.Conveyor1:FindFirstChild("Droppers")
            
        if droppers then
            for _, drop in ipairs(droppers:GetChildren()) do
                for _, prompt in ipairs(drop:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.ActionText:lower():find("place") then
                        triggerPrompt(prompt)
                    end
                end
            end
        end
    end)
end

