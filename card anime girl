task.spawn(function()
    while true do
        if Config.AutoFullCrateCycle then
            -- Siklus Lengkap: Ambil Crate -> Masukkan Polisher -> Ambil Hasil Poles -> Jual
            doCarryCrate()
            task.wait(0.2)
