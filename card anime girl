local function doBuyPedestals()
    local myPlot = getMyPlot()
    if not myPlot then return end
    
    pcall(function()
        local buttons = myPlot:FindFirstChild("Systems") 
            and myPlot.Systems:FindFirstChild("Classes") 
            and myPlot.Systems.Classes:FindFirstChild("Buttons")
            
        if buttons then
            for _, ped in ipairs(buttons:GetChildren()) do
                for _, prompt in ipairs(ped:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        triggerPrompt(prompt)
                    end
                end
            end
        end
        
        -- Cek SkipAll
        local skipAll = myPlot.Systems.Classes:FindFirstChild("SkipAll")
        if skipAll then
            for _, prompt in ipairs(skipAll:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    triggerPrompt(prompt)
                end
            end
        end
        
        -- PurchaseUpgrade Remote
        if Remotes:FindFirstChild("PurchaseUpgrade") then
            Remotes.PurchaseUpgrade:FireServer()
        end
    end)
end

