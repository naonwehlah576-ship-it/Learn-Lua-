        -- 1. Direct server remotes
        replica:FireServer("RequestRebirth")
        replica:FireServer("Rebirth")
        replica:FireServer("ClaimRebirth")
        replica:FireServer("DoRebirth")

        -- 2. GUI button interaction
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pGui then return end

        for _, btn in ipairs(pGui:GetDescendants()) do
            if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
                local bName = btn.Name:lower()
                local bText = (btn:IsA("TextButton") and btn.Text:lower()) or ""
                if bName == "rebirth" or bName == "rebirthbtn" or bName == "rebirthbutton" 
                   or bText == "rebirth" or bText:find("^rebirth") then
                    pcall(firesignal, btn.Activated)
                    pcall(firesignal, btn.MouseButton1Click)
                end
            end
        end

        task.wait(0.15)

        for _, gui in ipairs(pGui:GetChildren()) do
            local gName = gui.Name:lower()
            if gName:find("rebirth") then
                for _, b in ipairs(gui:GetDescendants()) do
                    if (b:IsA("TextButton") or b:IsA("ImageButton")) and b.Visible then
                        local btnTxt = (b:IsA("TextButton") and b.Text:lower()) or ""
                        local btnNm = b.Name:lower()
