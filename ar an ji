-- 1. Money Collector (Instant Touch)
local function collectMoney()
    if not myPlot then
        myPlot = PlotUtil.WaitForMyPlot(2)
        if not myPlot then return end
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local mc = myPlot:FindFirstChild("MoneyCollector")
    local glowyPart = mc and mc:FindFirstChild("GlowyPart")
    if glowyPart then
        if firetouchinterest then
            firetouchinterest(hrp, glowyPart, 0)
            task.wait(0.02)
            firetouchinterest(hrp, glowyPart, 1)
        end
    end

    pcall(function()
        replica:FireServer("SetAutoCollect", { ["On"] = true })
    end)
end

-- 2. Auto Roll Helpers
local function startNativeAutoRoll()
    pcall(function()
        replica:FireServer("AutoRollJoinedGroup")
        task.wait(0.1)
        replica:FireServer("RequestStartAutoRoll")
    end)
end

local function triggerFastRollPrompt()
    if not myPlot then return end
    for _, obj in ipairs(CollectionService:GetTagged("RollButton")) do
        if obj and obj:IsDescendantOf(myPlot) then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt and prompt.Enabled and fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end
    end
end

-- 3. Tower Helpers
local function stepTower()
    pcall(function()
        replica:FireServer("TowerEquipBest")
        task.wait(0.15)
        replica:FireServer("TowerSetAuto", { ["On"] = true })
        task.wait(0.15)
        local tId = settings.selectedTower or "Tower1"
        replica:FireServer("TowerStart", { ["TowerId"] = tId })
    end)
end

-- 4. Upgrade Helpers
local upgradeKeys = { "RollLuck", "UnitRolls", "Damage", "Money", "BossUpgrade" }
local function upgradeBase()
    pcall(function()
        for _, key in ipairs(upgradeKeys) do
            replica:FireServer("RequestBuyUpgrade", {
                ["Mode"] = "Max",
                ["UpgradeKey"] = key
            })
            task.wait(0.05)
        end
        if settings.autoFloor then
            replica:FireServer("RequestBuyFloor")
        end
    end)
end

-- 5. Rewards Claim Helpers
local function claimRewards()
    if settings.autoClaimDaily then
        pcall(function()
            replica:FireServer("ClaimDailyReward")
        end)
    end
    if settings.autoClaimPlaytime then
        pcall(function()
            for idx = 1, 12 do
                replica:FireServer("ClaimPlaytimeReward", { ["Index"] = idx })
                task.wait(0.04)
            end
        end)
    end
    if settings.autoSpinWheel then
        pcall(function()
            replica:FireServer("RequestWheelSpin")
        end)
    end
end

-- 6. Teleport Helpers
local function tpToPlot()
    if not myPlot then myPlot = PlotUtil.WaitForMyPlot(2) end
    local char = LocalPlayer.Character
    if char and myPlot then
        local sp = myPlot:FindFirstChild("SpawnPart")
        if sp then
            char:PivotTo(sp.CFrame + Vector3.new(0, 3, 0))
        end
    end
end

local function tpToTower()
    local char = LocalPlayer.Character
    local towerPart = Workspace:FindFirstChild("TowerPart")
    if char and towerPart then
        char:PivotTo(towerPart.CFrame + Vector3.new(0, 3, 0))
    end
end

local function tpToWheel()
    local char = LocalPlayer.Character
    local wheel = Workspace:FindFirstChild("SpinWheel")
    local base = wheel and wheel:FindFirstChild("Base")
    if char and base then
        char:PivotTo(base.CFrame + Vector3.new(0, 3, 0))
    end
end

