local function getRolledUnitsOnStation()
    local units = {}
    local tagged = CollectionService:GetTagged("RolledUnit")
    for _, model in ipairs(tagged) do
        if model and model.Parent then
            local slotIdx = model:GetAttribute("SlotIndex")
            local buyPrompt = model:FindFirstChild("BuyPrompt", true)
            local rollInfo = model:FindFirstChild("UnitRollInfo", true)
            
            local rarity = "Common"
            local unitName = model.Name
            local price = 0
            local unitId = nil

            if buyPrompt then
                rarity = buyPrompt.ObjectText ~= "" and buyPrompt.ObjectText or rarity
                local promptName = buyPrompt.ActionText:gsub("^Buy%s*", "")
                if promptName ~= "" then unitName = promptName end
            end

            if rollInfo and rollInfo:FindFirstChild("Panel") then
                local p = rollInfo.Panel
                if p:FindFirstChild("UnitTier") and p.UnitTier.Text ~= "" then
                    rarity = p.UnitTier.Text
                end
                if p:FindFirstChild("UnitName") and p.UnitName.Text ~= "" then
                    unitName = p.UnitName.Text
                end
                if p:FindFirstChild("UnitCost") then
                    price = parseCostString(p.UnitCost.Text)
                end
            end

            -- Match UnitId dari UnitConfig jika ada
            if UnitConfig then
                for uId, uDef in pairs(UnitConfig) do
                    if uDef.DisplayName == unitName or uId == unitName then
                        unitId = uId
                        if price == 0 and uDef.Price then price = uDef.Price end
                        if uDef.Rarity then rarity = uDef.Rarity end
                        break
                    end
                end
            end

            table.insert(units, {
                model = model,
                slotIndex = slotIdx or 1,
                unitId = unitId or unitName,
                name = unitName,
                rarity = rarity,
                price = price,
                prompt = buyPrompt
            })
        end
    end
    return units
end

local function processFilterBuyAndRollGuard()
    if not settings.autoBuyRolled then
        isRollPausedForMoney = false
        rollPauseReason = ""
        return
    end

    local rolledUnits = getRolledUnitsOnStation()
    local money = getPlayerMoney()
    local waitingToBuy = false

    for _, unit in ipairs(rolledUnits) do
        local wantBuy = settings.filterRarities[unit.rarity] == true
        if wantBuy then
            if money >= unit.price then
                -- Uang CUKUP: Langsung beli!
                pcall(function()
                    replica:FireServer("RequestBuyRolledUnit", {
                        ["SlotIndex"] = unit.slotIndex,
                        ["UnitId"] = unit.unitId
                    })
                end)
                if unit.prompt and fireproximityprompt then
                    pcall(fireproximityprompt, unit.prompt)
                end
                task.wait(0.2)
            else
                -- Uang KURANG untuk unit yang dicentang!
                if settings.stopRollIfBroke then
                    waitingToBuy = true
                    rollPauseReason = string.format("Kurang Uang: %s [%s] ($%s)", unit.name, unit.rarity, NumberFormat.Abbreviate(unit.price))
                    break
                end
            end
        end
    end

    isRollPausedForMoney = waitingToBuy
    if not waitingToBuy then
        rollPauseReason = ""
    end
end

