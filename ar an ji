local function getCheapestBaseUpgrade()
    local upgrades = (replica.Data and replica.Data.Upgrades) or {}
    local keys = {"Damage", "Money", "RollLuck", "UnitRolls", "BossUpgrade"}
    local list = {}

    for _, key in ipairs(keys) do
        local curLvl = upgrades[key] or 1
        local cost = PlotUpgradeConfig.PriceForLevel(key, curLvl)
        if cost ~= nil then
            table.insert(list, {
                key = key,
                cost = cost,
                level = curLvl
            })
        end
    end

    if #list == 0 then return nil end
    table.sort(list, function(a, b) return a.cost < b.cost end)
    return list[1]
end

local function stepSmartBaseUpgrade()
    local cheapest = getCheapestBaseUpgrade()
    if cheapest then
        nextCheapestBaseName = string.format("%s (Lv.%d)", cheapest.key, cheapest.level)
        nextCheapestBaseCost = cheapest.cost

        local money = getPlayerMoney()
        if money >= cheapest.cost then
            pcall(function()
                replica:FireServer("RequestBuyUpgrade", {
                    ["Mode"] = "Single",
                    ["UpgradeKey"] = cheapest.key
                })
            end)
            task.wait(0.35)
        end
    else
        nextCheapestBaseName = "Maxed Out"
        nextCheapestBaseCost = 0
    end

    -- Auto Floor jika uang cukup
    if settings.autoFloor and FloorConfig and FloorConfig.FloorCosts then
        local curFloors = (replica.Data and replica.Data.UnlockedFloors) or 1
        local nextFloor = curFloors + 1
        local floorCost = FloorConfig.FloorCosts[nextFloor]
        if floorCost and getPlayerMoney() >= floorCost then
            pcall(function() replica:FireServer("RequestBuyFloor") end)
            task.wait(0.4)
        end
    end
end

