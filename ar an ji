local function collectMoney()
    if not myPlot then
        myPlot = PlotUtil.WaitForMyPlot(2)
        if not myPlot then return end
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local mc = myPlot:FindFirstChild("MoneyCollector")
    local glowyPart = mc and mc:FindFirstChild("GlowyPart")
    if glowyPart and firetouchinterest then
        firetouchinterest(hrp, glowyPart, 0)
        task.wait(0.02)
        firetouchinterest(hrp, glowyPart, 1)
    end

    pcall(function()
        replica:FireServer("SetAutoCollect", { ["On"] = true })
    end)
end

local function startNativeAutoRoll()
    pcall(function()
        replica:FireServer("AutoRollJoinedGroup")
        task.wait(0.1)
        replica:FireServer("RequestStartAutoRoll")
    end)
end

local function triggerFastRollPrompt()
    if not myPlot then return end
    for _, obj in ipairs(CollectionService:GetTagged("RollButton")) do
        if obj and obj:IsDescendantOf(myPlot) then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt and prompt.Enabled and fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end
    end
end

local function stepTower()
    pcall(function()
        replica:FireServer("TowerEquipBest")
        task.wait(0.15)
        replica:FireServer("TowerSetAuto", { ["On"] = true })
        task.wait(0.15)
        local tId = settings.selectedTower or "Tower1"
        replica:FireServer("TowerStart", { ["TowerId"] = tId })
    end)
end

-- Fix: Auto Upgrade Base (Dual Method: Physical Buttons + Dual Single/Max Server Calls with Cooldown Guard)
local function upgradeBase()
    pcall(function()
        if not myPlot then myPlot = PlotUtil.WaitForMyPlot(2) end
        if not myPlot then return end

        local function clickBtn(b)
            if not b then return end
            if firesignal then
                pcall(firesignal, b.Activated)
                pcall(firesignal, b.MouseButton1Click)
            end
        end

        -- Method 1: Click physical SurfaceGui Buttons on Plot
        local lsc = myPlot:FindFirstChild("LuckAndSpinCount")
        local lPart = lsc and lsc:FindFirstChild("SurfaceGUIPART")
        local lGui = lPart and lPart:FindFirstChild("SurfaceGui")
        local lHolder = lGui and lGui:FindFirstChild("Holder")
        if lHolder then
            local lf = lHolder:FindFirstChild("LuckFrame")
            if lf then
                clickBtn(lf:FindFirstChild("MaxButton") or lf:FindFirstChild("SingleButton"))
            end
            local sc = lHolder:FindFirstChild("SpinCount")
            if sc then
                clickBtn(sc:FindFirstChild("SingleButton"))
            end
        end

        local dms = myPlot:FindFirstChild("DamageMoneySign")
        local dPart = dms and dms:FindFirstChild("SurfaceGUIPART")
        local dGui = dPart and dPart:FindFirstChild("SurfaceGui")
        local dHolder = dGui and dGui:FindFirstChild("Holder")
        if dHolder then
            local df = dHolder:FindFirstChild("DamageFrame")
            if df then clickBtn(df:FindFirstChild("MaxButton") or df:FindFirstChild("SingleButton")) end
            local mf = dHolder:FindFirstChild("MoneyFrame")
            if mf then clickBtn(mf:FindFirstChild("MaxButton") or mf:FindFirstChild("SingleButton")) end
        end

        local bUp = myPlot:FindFirstChild("BossUpgrade")
        local bPart = bUp and bUp:FindFirstChild("SurfaceGuiPart")
        local bGui = bPart and bPart:FindFirstChild("SurfaceGui")
        local bHolder = bGui and bGui:FindFirstChild("Holder")
        if bHolder then
            local bf = bHolder:FindFirstChild("BossFrame")
            if bf then clickBtn(bf:FindFirstChild("SingleButton")) end
        end

        -- Method 2: Direct Server Calls with Cooldown Protection
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Max", ["UpgradeKey"] = "RollLuck" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Single", ["UpgradeKey"] = "RollLuck" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Single", ["UpgradeKey"] = "UnitRolls" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Max", ["UpgradeKey"] = "Damage" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Single", ["UpgradeKey"] = "Damage" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Max", ["UpgradeKey"] = "Money" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Single", ["UpgradeKey"] = "Money" })
        task.wait(0.1)
        replica:FireServer("RequestBuyUpgrade", { ["Mode"] = "Single", ["UpgradeKey"] = "BossUpgrade" })

        if settings.autoFloor then
            task.wait(0.1)
            replica:FireServer("RequestBuyFloor")
        end
    end)
end

local function claimRewards()
    if settings.autoClaimDaily then
        pcall(function() replica:FireServer("ClaimDailyReward") end)
    end
    if settings.autoClaimPlaytime then
        pcall(function()
            for idx = 1, 12 do
                replica:FireServer("ClaimPlaytimeReward", { ["Index"] = idx })
                task.wait(0.04)
            end
        end)
    end
    if settings.autoSpinWheel then
        pcall(function() replica:FireServer("RequestWheelSpin") end)
    end
end

local function tpToPlot()
    if not myPlot then myPlot = PlotUtil.WaitForMyPlot(2) end
    local char = LocalPlayer.Character
    if char and myPlot then
        local sp = myPlot:FindFirstChild("SpawnPart")
        if sp then char:PivotTo(sp.CFrame + Vector3.new(0, 3, 0)) end
    end
end

local function tpToTower()
    local char = LocalPlayer.Character
    local towerPart = Workspace:FindFirstChild("TowerPart")
    if char and towerPart then char:PivotTo(towerPart.CFrame + Vector3.new(0, 3, 0)) end
end

local function tpToWheel()
    local char = LocalPlayer.Character
    local wheel = Workspace:FindFirstChild("SpinWheel")
    local base = wheel and wheel:FindFirstChild("Base")
    if char and base then char:PivotTo(base.CFrame + Vector3.new(0, 3, 0)) end
end

local function formatTower(val)
    if type(val) == "number" then return tostring(val) end
    if type(val) == "table" then
        local best = 0
        for _, f in pairs(val) do
            if type(f) == "number" and f > best then best = f end
        end
        return best > 0 and ("Fl." .. best) or "Ready"
    end
    return "Ready"
end

