local function formatTower(val)
    if type(val) == "number" then return tostring(val) end
    if type(val) == "table" then
        local best = 0
        for _, f in pairs(val) do
            if type(f) == "number" and f > best then best = f end
        end
        return best > 0 and ("Fl." .. best) or "Ready"
    end
    return "Ready"
end

