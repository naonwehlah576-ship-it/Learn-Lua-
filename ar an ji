local function parseCostString(txt)
    if not txt then return 0 end
    if txt == "FREE" or txt == "0" then return 0 end
    local clean = tostring(txt):gsub("[%$,]", ""):gsub("%s+", "")
    local num = tonumber(clean:match("[%d%.]+"))
    if not num then return 0 end
    if clean:find("[kK]") then num = num * 1e3
    elseif clean:find("[mM]") then num = num * 1e6
    elseif clean:find("[bB]") then num = num * 1e9
    elseif clean:find("[tT]") then num = num * 1e12
    end
    return math.floor(num)
end

