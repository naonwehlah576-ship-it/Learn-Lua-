-- Helper: Create Section Header
local function makeHeader(text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = " " .. text
    lbl.TextColor3 = Color3.fromRGB(180, 200, 240)
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = Scroll
    return lbl
end

-- Helper: Create Toggle Button
local function makeToggle(name, text, stateKey, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = settings[stateKey] and Color3.fromRGB(35, 75, 55) or Color3.fromRGB(40, 44, 58)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. text .. (settings[stateKey] and " [ON]" or " [OFF]")
    btn.TextColor3 = settings[stateKey] and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(220, 220, 230)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Scroll

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    btn.Activated:Connect(function()
        settings[stateKey] = not settings[stateKey]
        local on = settings[stateKey]
        btn.BackgroundColor3 = on and Color3.fromRGB(35, 75, 55) or Color3.fromRGB(40, 44, 58)
        btn.Text = "  " .. text .. (on and " [ON]" or " [OFF]")
        btn.TextColor3 = on and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(220, 220, 230)
        saveConfig()
        if callback then callback(on) end
    end)
    return btn
end

-- Helper: Create Action / TP Button
local function makeActionBtn(name, text, color, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = color or Color3.fromRGB(45, 55, 80)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Parent = Scroll

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    btn.Activated:Connect(function()
        if callback then callback() end
    end)
    return btn
end

