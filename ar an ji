-- 3. HERO / PAD UPGRADES (Target Level + Cheapest First)
-- ============================================================================

local function getCheapestHeroUpgrade()
    local data = replica.Data
    if not data or not data.PlacedUnits or not data.OwnedUnits then return nil end
    local targetLvl = tonumber(settings.targetHeroLevel) or 25
    local candidates = {}

    for floorIdx, squares in pairs(data.PlacedUnits) do
        if type(squares) == "table" then
            for squareIdx, ownedId in pairs(squares) do
                local unit = data.OwnedUnits[ownedId]
                if unit then
                    local curLvl = unit.Level or unit.Lvl or 1
                    if curLvl < targetLvl then
                        local unitDef = UnitConfig and UnitConfig[unit.UnitId]
                        local basePrice = (unitDef and unitDef.Price) or 100
                        local cost = 100
                        if UpgradeConfig and UpgradeConfig.CostForLevel then
                            cost = UpgradeConfig.CostForLevel(basePrice, curLvl)
                        else
                            cost = math.floor(basePrice * 0.1 * (1.747 ^ (curLvl - 1)) + 0.5)
                        end
                        table.insert(candidates, {
                            ownedUnitId = ownedId,
                            floorIndex = floorIdx,
                            squareIndex = squareIdx,
                            unitId = unit.UnitId,
                            name = (unitDef and unitDef.DisplayName) or unit.UnitId,
                            curLevel = curLvl,
                            cost = cost,
                        })
                    end
                end
            end
        end
    end

    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.cost < b.cost end)
    return candidates[1]
end

local function stepHeroUpgrade()
    local cheapestHero = getCheapestHeroUpgrade()
    if cheapestHero then
        nextCheapestHeroName = string.format("%s (Fl.%s Sq.%s Lv.%d)", cheapestHero.name, tostring(cheapestHero.floorIndex), tostring(cheapestHero.squareIndex), cheapestHero.curLevel)
        nextCheapestHeroCost = cheapestHero.cost

        local money = getPlayerMoney()
        if money >= cheapestHero.cost then
            -- Tembak remote upgrade unit
            pcall(function()
                replica:FireServer("RequestUpgradeUnit", { ["OwnedUnitId"] = cheapestHero.ownedUnitId })
            end)
            pcall(function()
                replica:FireServer("RequestUpgradeUnit", { ["FloorIndex"] = cheapestHero.floorIndex, ["SquareIndex"] = cheapestHero.squareIndex })
            end)
            pcall(function()
                replica:FireServer("RequestUpgradePlacedUnit", { ["FloorIndex"] = cheapestHero.floorIndex, ["SquareIndex"] = cheapestHero.squareIndex })
            end)
            task.wait(0.35)
        end
    else
        nextCheapestHeroName = "Semua Sudah Target Level"
        nextCheapestHeroCost = 0
    end
end

