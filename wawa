Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 4)

local isFlying = false
local flyConnection

-- Fungsi utama terbang WASD
local function UpdateFly()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if isFlying then
        -- Kunci dari gravitasi
        hrp.Anchored = true
        
        if flyConnection then flyConnection:Disconnect() end
        
        flyConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if not char or not hrp or not hrp.Parent then return end
            
            local speed = tonumber(SpeedBox.Text) or 50
            local moveVector = Vector3.zero
            
            -- Baca input WASD
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + Camera.CFrame.RightVector end
            
            -- Atas (Space) / Bawah (Ctrl)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector - Vector3.new(0, 1, 0) end
            
            if moveVector.Magnitude > 0 then
                moveVector = moveVector.Unit
                -- Update posisi mulus sesuai speed dan framerate
                hrp.CFrame = hrp.CFrame + (moveVector * speed * deltaTime)
            end
            
            -- Noclip otomatis pas terbang biar ga nyangkut pohon
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
    else
        -- Matikan terbang
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        hrp.Anchored = false
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    ToggleBtn.BackgroundColor3 = isFlying and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    ToggleBtn.Text = isFlying and "FLY: ON" or "FLY: OFF"
    UpdateFly()
end)

CloseBtn.MouseButton1Click:Connect(function()
    isFlying = false
    UpdateFly()
    ScreenGui:Destroy()
end)
