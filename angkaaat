-- Parser Koordinat
local function parseCoords(str, default)
    default = default or Vector3.zero
    if not str then return default end
    local x, y, z = string.match(str, "([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
    if x and y and z then
        return Vector3.new(tonumber(x) or default.X, tonumber(y) or default.Y, tonumber(z) or default.Z)
    end
    return default
end

