-- 3. BACKGROUND LOOP AUTO CLICK (HYBRID VIRTUAL INPUT)
local function performClick(screenVec, target3D)
    if typeof(fireclickdetector) == "function" and target3D then
        local cam = workspace.CurrentCamera
        if cam then
            local ray = cam:ViewportPointToRay(screenVec.X, screenVec.Y)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = RaycastFilterType.Exclude
            raycastParams.FilterDescendantsInstances = {lp.Character}
            local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
            if hit and hit.Instance then
                local detector = hit.Instance:FindFirstChildWhichIsA("ClickDetector") or hit.Instance.Parent:FindFirstChildWhichIsA("ClickDetector")
                if detector then
                    fireclickdetector(detector)
                    return
                end
            end
        end
    end

    VirtualInputManager:SendMouseButtonEvent(screenVec.X, screenVec.Y, 0, true, game, 1)
    VirtualInputManager:SendMouseButtonEvent(screenVec.X, screenVec.Y, 0, false, game, 1)
    VirtualUser:Button1Down(screenVec)
    VirtualUser:Button1Up(screenVec)
end

RunService.RenderStepped:Connect(function()
    if config.autoClick then
        local target3D = parseCoords(config.clickPos, Vector3.zero)
        local cam = workspace.CurrentCamera
        if cam then
            local screenPoint, onScreen = cam:WorldToViewportPoint(target3D)
            if onScreen then
                local screenVec = Vector2.new(screenPoint.X, screenPoint.Y)
                performClick(screenVec, target3D)
            end
        end
    end
end)

-- 4. PARSER HARGA
local function parsePrice(str)
    if not str then return 0 end
    local clean = string.gsub(str, "[%$,%s]", "")
    local val, unit = string.match(clean, "^([%d%.]+)(%a?)$")
    if not val then return 0 end
    val = tonumber(val) or 0
    unit = string.upper(unit or "")
    if unit == "K" then return val * 1e3
    elseif unit == "M" then return val * 1e6
    elseif unit == "B" then return val * 1e9
    elseif unit == "T" then return val * 1e12
    end
    return val
end

local function getPromptPos(prompt)
    if not prompt then return nil end
    local p = prompt.Parent
    if p:IsA("BasePart") then return p.Position
    elseif p:IsA("Attachment") then return p.WorldPosition
    elseif p:IsA("Model") and p.PrimaryPart then return p.PrimaryPart.Position
    else
        local bp = p:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp.Position end
    end
    return nil
end

-- 5. NAVIGASI TELEPORT & WALK
local function teleportTo(position)
    local myChar = lp.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(position + Vector3.new(0, 1.2, 0))
        task.wait(0.28)
        return true
    end
    return false
end

local function walkTo(position, timeout)
    timeout = timeout or 20
    local myChar = lp.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChild("Humanoid")
    if not hrp or not hum then return false end

    hum.WalkSpeed = config.customSpeed
    hum:MoveTo(position)
    local start = os.clock()
    while config.running and (os.clock() - start < timeout) do
        local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude
        if dist <= 4 then return true end
        hum:MoveTo(position)
        task.wait(0.15)
    end
    return false
end

-- 6. PROXIMITY INTERACTION
local function pickupPrompt(prompt)
    if not prompt or not prompt.Enabled then return end
    local prev = prompt.HoldDuration
    prompt.HoldDuration = 0
    if typeof(fireproximityprompt) == "function" then
        fireproximityprompt(prompt)
    end
    prompt:InputHoldBegin()
    task.wait(0.05)
    prompt:InputHoldEnd()
    prompt.HoldDuration = prev
end

-- 7. RETURN TO SPAWN
local function returnToSpawn()
    pcall(function()
        local btn = lp.PlayerGui.MainUI.Top.TeleportContainer.Spawn
        if typeof(firesignal) == "function" then
            firesignal(btn.Activated)
        elseif typeof(getconnections) == "function" then
            for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() end
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
        end
    end)
    task.wait(1)
end

-- 8. SCANNING HARTA
local function scanTopTreasures(maxStage, limit)
    local list = {}
    local stagesFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Stages")
    if not stagesFolder then return list end

    for s = 1, maxStage do
        local st = stagesFolder:FindFirstChild("Stage" .. s)
        if st then
            for _, obj in ipairs(st:GetChildren()) do
                if obj:IsA("Model") then
                    local earn = obj:FindFirstChild("InfoGUI", true)
                    earn = earn and earn:FindFirstChild("Earnings", true)
                    if earn and earn:IsA("TextLabel") then
                        local price = parsePrice(earn.Text or earn.ContentText)
                        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                        local targetPos = getPromptPos(prompt) or (obj.PrimaryPart and obj.PrimaryPart.Position) or obj:GetPivot().Position
                        if prompt and price > 0 then
                            table.insert(list, {
                                model = obj,
                                price = price,
                                prompt = prompt,
                                pos = targetPos,
                                name = obj.Name
                            })
                        end
                    end
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.price > b.price end)

    local res = {}
    for i = 1, math.min(limit, #list) do
        table.insert(res, list[i])
    end
    return res
end

-- 9. LOOP UTAMA BOT (DENGAN 2 MENIT ANTI-STUCK TIMEOUT)
local function executeFarm(updateStatus)
    while config.running do
        local stagesFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Stages")
        if not stagesFolder then break end

        -- FASE 1: Buka Stage Berurutan
        for s = 1, config.targetStage do
            if not config.running then break end
            local st = stagesFolder:FindFirstChild("Stage" .. s)
            if st then
                local stone = st:FindFirstChild("Stone" .. s)
                if stone then
                    updateStatus("Stage " .. s .. ": TP ke LIFT...")
                    local stand = st:FindFirstChild("LiftZone") or st:FindFirstChild("LuckInfo")
                    if stand then
                        teleportTo(stand.Position)
                        task.wait(0.3)
                    end

                    local myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    local lockPos = myHrp and myHrp.Position

                    updateStatus("Stage " .. s .. ": Mengangkat batu...")
                    
                    -- Timer Anti-Stuck 2 Menit (120 Detik)
                    local stoneStartTime = os.clock()
                    local STONE_TIMEOUT = 120 

                    while config.running and st:FindFirstChild("Stone" .. s) do
                        -- Cek apakah sudah stuck lebih dari 2 menit
                        if (os.clock() - stoneStartTime) >= STONE_TIMEOUT then
                            updateStatus("Stage " .. s .. ": Stuck 2m! Re-teleport...")
                            if stand then
                                teleportTo(stand.Position)
                                task.wait(0.3)
                                myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                                lockPos = myHrp and myHrp.Position
                            end
                            stoneStartTime = os.clock() -- Reset timer stuck
                        end

                        -- Kunci posisi agar tidak terlempar/terdorong
                        local curHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                        if lockPos and curHrp and (curHrp.Position - lockPos).Magnitude > 15 then
                            curHrp.CFrame = CFrame.new(lockPos)
                            curHrp.AssemblyLinearVelocity = Vector3.zero
                        end
                        task.wait(0.5)
                    end
                    updateStatus("Stage " .. s .. " Terbuka!")
                    task.wait(0.3)
                end
            end
        end

        if not config.running then break end

        -- FASE 2: Scan Barang Termahal
        updateStatus("Scanning barang termahal...")
        local targets = scanTopTreasures(config.targetStage, config.itemCapacity)
        updateStatus("Ditemukan " .. #targets .. " barang.")

        -- FASE 3: Ambil Barang
        for idx, item in ipairs(targets) do
            if not config.running then break end
            
            if item.model and item.model.Parent and item.prompt and item.prompt.Parent then
                updateStatus("Ambil [" .. idx .. "/" .. #targets .. "] " .. item.name)

                if config.pickupMode == "Teleport" then
                    teleportTo(item.pos)
                else
                    walkTo(item.pos, 15)
                end

                local tries = 0
                while config.running and item.model and item.model.Parent and tries < 5 do
                    pickupPrompt(item.prompt)
                    task.wait(0.25)
                    tries = tries + 1
                end
            end
        end

        if not config.running then break end

        -- FASE 4: Balik Spawn
        updateStatus("Kembali ke Spawn...")
        returnToSpawn()
        task.wait(2)
    end
    updateStatus("Status: Berhenti (OFF)")
end

