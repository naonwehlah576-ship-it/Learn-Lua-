-- Rarity Toggles
local ScrollRarity = Instance.new("ScrollingFrame")
ScrollRarity.Size = UDim2.new(1, -20, 1, -290)
ScrollRarity.Position = UDim2.new(0, 10, 0, 280)
ScrollRarity.BackgroundTransparency = 1
ScrollRarity.ScrollBarThickness = 4
ScrollRarity.CanvasSize = UDim2.new(0, 0, 0, 350)
ScrollRarity.Parent = MainFrame
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 5)
layout.Parent = ScrollRarity

local RarityOrder = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cosmic", "Secret", "Divine", "Eternal"}
for _, rarity in ipairs(RarityOrder) do
    if Config.Rarities[rarity] ~= nil then
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 30)
        btn.BackgroundColor3 = Config.Rarities[rarity] and Color3.fromRGB(50, 150, 200) or Color3.fromRGB(60, 60, 65)
        btn.Text = rarity
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 12
        btn.Parent = ScrollRarity
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            Config.Rarities[rarity] = not Config.Rarities[rarity]
            btn.BackgroundColor3 = Config.Rarities[rarity] and Color3.fromRGB(50, 150, 200) or Color3.fromRGB(60, 60, 65)
            SaveConfig()
        end)
    end
end

-- ==========================================
-- MAIN AUTOMATION LOOP
-- ==========================================
task.spawn(function()
    while task.wait(0.2) do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if not Config.Enabled or not hrp or not humanoid or humanoid.Health <= 0 then
            ToggleNoclip(false)
            continue
        end

        local isServerNight = CheckIsServerNight()
        if isServerNight then
            IsBarrierOpen = false
        end

        -- JIKA MALAM ATAU BARRIER BELUM BUKA:
        if isServerNight or not IsBarrierOpen then
            if isServerNight then
                SetStatus("🌙 Malam / Area Ditutup (Standby Safe Zone)")
            end
            
            local distToSafe = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(Config.SafeArea.X, 0, Config.SafeArea.Z)).Magnitude
            if distToSafe > 5 then
                if Config.MoveMode == "Walk" then
                    TrueWalkTo(Config.SafeArea, 10)
                else
                    ToggleNoclip(true)
                    PureCFrameFly(Vector3.new(hrp.Position.X, Config.FlyHeight, hrp.Position.Z))
                    PureCFrameFly(Vector3.new(Config.SafeArea.X, Config.FlyHeight, Config.SafeArea.Z))
                    PureCFrameFly(Config.SafeArea)
                    ToggleNoclip(false)
                end
            end
            task.wait(0.3)
            continue
        end

        local targetData = GetBestTargetEgg()
        
        if targetData then
            if CheckIsServerNight() or not IsBarrierOpen then
                continue
            end

            local targetEgg = targetData.Record
            local eggRarity = targetData.Rarity
            local eggCategory = targetData.Category
            local weightStr = FormatKg(targetData.WeightKg)
            local carriedSuccessfully = false

            -- FORMAT STATUS DISPLAY
            if eggRarity == "Divine" then
                SetStatus("Target: [👑 DIVINE | " .. eggCategory .. " | " .. weightStr .. "]...")
            elseif eggRarity == "Eternal" then
                SetStatus("Target: [🌌 ETERNAL | " .. eggCategory .. " | " .. weightStr .. "]...")
            elseif targetData.WeightKg >= Config.TitanWeight and Config.TitanWeight > 0 then
                SetStatus("Target: [⚡ TITAN " .. weightStr .. " | " .. eggCategory .. "]...")
            else
                SetStatus("Target: [" .. eggRarity .. " | " .. eggCategory .. " | " .. weightStr .. "]...")
            end

            local safePos = Config.SafeArea
            local eggPos = targetEgg.BottomCFrame.Position
            local currentPos = hrp.Position

            -- 🚀 PROSES MENUJU KE TELUR
            if Config.MoveMode == "Walk" then
                -- MODE WALK: Lari sekencang peluru dengan Rem Cakram Aktif
                if not TrueWalkTo(eggPos, 20) then continue end
            else
                -- MODE FLY: Melayang CFrame di ketinggian FlyHeight
                ToggleNoclip(true)
                local flySafePos = Vector3.new(safePos.X, Config.FlyHeight, safePos.Z)
                local flyEggPos = Vector3.new(eggPos.X, Config.FlyHeight, eggPos.Z)

                if IsInFarmArea(currentPos) then
                    local currentHoverPos = Vector3.new(currentPos.X, Config.FlyHeight, currentPos.Z)
                    if not PureCFrameFly(currentHoverPos) then continue end
                    if not PureCFrameFly(flyEggPos) then continue end
                else
                    local distToSafe = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(safePos.X, 0, safePos.Z)).Magnitude
                    if distToSafe > 5 then
                        if not PureCFrameFly(Vector3.new(currentPos.X, Config.FlyHeight, currentPos.Z)) then continue end
                        if not PureCFrameFly(flySafePos) then continue end
                        if not PureCFrameFly(safePos) then continue end
                    end

                    if not PureCFrameFly(flySafePos) then continue end
                    if not PureCFrameFly(flyEggPos) then continue end
                end

                local landEggPos = eggPos + Vector3.new(0, 3.5, 0)
                SetStatus("Mengambil [" .. eggCategory .. " (" .. weightStr .. ")]...")
                if not PureCFrameFly(landEggPos) then continue end
            end

            -- 4. MENGAMBIL TELUR
            ToggleNoclip(false)
            task.wait(0.25)

            local snapshot = EggCmds.RequestAreaEggSnapshot()
            local eggStillValid = false
            if snapshot and snapshot.Records then
                for _, rec in ipairs(snapshot.Records) do
                    if rec.Uid == targetEgg.Uid and (rec.State == "Slot" or rec.State == "Dropped") then
                        eggStillValid = true
                        break
                    end
                end
            end

            if eggStillValid then
                local slotKey = nil
                if AreaEggSlotIdentity.IsFirstAreaUid(targetEgg.Uid) then
                    slotKey = AreaEggSlotIdentity.BuildSlotKey(targetEgg.AreaId, targetEgg.NestId)
                end
                
                local success = pcall(function()
                    EggCmds.RequestCarryAreaEgg(targetEgg.Uid, slotKey)
                end)
                
                if success then
                    carriedSuccessfully = true
                end
            end
            
            IgnoredEggs[targetEgg.Uid] = tick() + 10

            -- 5. MEMBAWA TELUR PULANG KE SAFE AREA
            SetStatus("Membawa [" .. eggCategory .. " (" .. weightStr .. ")] Pulang...")

            if Config.MoveMode == "Walk" then
                -- Lari kembali ke Safe Zone dengan Rem Cakram
                if not TrueWalkTo(safePos, 20) then continue end
            else
                ToggleNoclip(true)
                local flyEggPos = Vector3.new(eggPos.X, Config.FlyHeight, eggPos.Z)
                local flySafePos = Vector3.new(safePos.X, Config.FlyHeight, safePos.Z)
                if not PureCFrameFly(flyEggPos) then continue end
                if not PureCFrameFly(flySafePos) then continue end
                if not PureCFrameFly(safePos) then continue end
            end

            -- 6. VERIFIKASI CLAIM DI SAFE AREA
            ToggleNoclip(false)
            
            if carriedSuccessfully then
                SetStatus("Claiming [" .. eggCategory .. "]...")
                JustClaimed = false
                local claimStart = tick()
                
                while not JustClaimed and (tick() - claimStart < 2.0) and Config.Enabled do
                    task.wait(0.1)
                end
                
                EggsStolenCount = EggsStolenCount + 1
                UpdateCounterDisplay()
                SetStatus("Sukses Curi [" .. eggCategory .. " (" .. weightStr .. ")]! (+1)")
                task.wait(0.5)
            else
                SetStatus("Telur Gagal / Keduluan...")
                task.wait(0.3)
            end
            
            SetStatus("Standby / Mencari Telur...")
        else
            -- Status Idle
            SetStatus("Mencari Telur...")
            local distToSafe = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(Config.SafeArea.X, 0, Config.SafeArea.Z)).Magnitude
            if distToSafe > 5 then
                if Config.MoveMode == "Walk" then
                    TrueWalkTo(Config.SafeArea, 10)
                else
                    ToggleNoclip(true)
                    PureCFrameFly(Vector3.new(hrp.Position.X, Config.FlyHeight, hrp.Position.Z))
                    PureCFrameFly(Vector3.new(Config.SafeArea.X, Config.FlyHeight, Config.SafeArea.Z))
                    PureCFrameFly(Config.SafeArea)
                    ToggleNoclip(false)
                end
            end
        end
    end
end)
