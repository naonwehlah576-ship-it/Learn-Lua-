-- ==========================================
-- MOVEMENT HELPER (WALK MODE)
-- ==========================================
local function WalkTo(targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    hum:MoveTo(targetPos)

    local reached = false
    local connection
    connection = hum.MoveToFinished:Connect(function()
        reached = true
    end)

    local startTime = tick()
    while not reached and Config.AutoSteal do
        task.wait(0.1)
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then break end
        
        -- Paksa WalkSpeed terus biar gak ditarik server
        hum.WalkSpeed = Config.CustomSpeed
        
        -- Cek jarak murni tanpa sumbu Y
        local currentDist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
        if currentDist <= 3.5 then
            break
        end

        if tick() - startTime > 7 then
            hum:MoveTo(targetPos)
            startTime = tick()
        end
    end

    if connection then connection:Disconnect() end
    hum.WalkSpeed = 16 -- BALIK JADI NORMAL HUMANOID
    return true
end

