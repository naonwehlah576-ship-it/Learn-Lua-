-- ==========================================
-- AUTO STEAL LOGIC
-- ==========================================
local function GetRarity(category)
    local assetData = AssetsDirectory.Directory and AssetsDirectory.Directory[category]
    if assetData and assetData.Rarity then
        return typeof(assetData.Rarity) == "table" and (assetData.Rarity.Name or assetData.Rarity.DisplayName) or tostring(assetData.Rarity)
    end
    return "Unknown"
end

local function GetTargetEgg()
    local snapshot = EggCmds.RequestAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil end
    
    for _, record in ipairs(snapshot.Records) do
        if record.State == "Slot" or record.State == "Dropped" then
            local category = record.AssetCategory or "Unknown"
            local rarity = GetRarity(category)
            
            -- Cek apakah rarity telur ini dicentang di GUI
            if Config.Rarities[rarity] and record.BottomCFrame then
                return record
            end
        end
    end
    return nil
end

local function ClaimSafeZone()
    -- Tween kembali ke Safe Area untuk reset posisi dan klaim
    TweenTo(Config.SafeArea)
    task.wait(1) -- Beri waktu sedikit untuk game mendeteksi claim
end

task.spawn(function()
    while task.wait(0.5) do
        if not Config.AutoSteal then
            ToggleNoclip(false)
            continue 
        end
        
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        
        local currentPos = char.HumanoidRootPart.Position
        
        -- 1. Pastikan mulai dari Safe Area jika tidak ada target
        if (currentPos - Config.SafeArea).Magnitude > 10 then
            -- Balik ke safe area dulu lewat highway Y
            TweenTo(Vector3.new(currentPos.X, Config.HoverY, currentPos.Z))
            TweenTo(Vector3.new(Config.SafeArea.X, Config.HoverY, Config.SafeArea.Z))
            TweenTo(Config.SafeArea)
        end
        
        -- 2. Scan Telur
        local targetEgg = GetTargetEgg()
        if targetEgg then
            local eggPos = targetEgg.BottomCFrame.Position
            
            -- 3. Berangkat lewat Highway (Y = 72)
            TweenTo(Vector3.new(Config.SafeArea.X, Config.HoverY, Config.SafeArea.Z)) -- Naik dari safe area
            TweenTo(Vector3.new(eggPos.X, Config.HoverY, eggPos.Z)) -- Jalan lurus ke atas target
            TweenTo(eggPos) -- Turun ke target
            
            task.wait(0.3) -- Jeda stabilisasi posisi untuk server
            
            -- 4. Steal Telur
            -- Note: Karena kita butuh interaksi prompt, kita scan workspace
            local promptFired = false
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Name == "CarryAreaEgg" then
                    local parent = obj.Parent
                    if parent and (parent.Position - eggPos).Magnitude < 10 then
                        fireproximityprompt(obj, obj.HoldDuration, true)
