-- ==========================================
-- ANTI-TREADMILL BYPASS (Disable Raycast Query)
-- ==========================================
task.spawn(function()
    local function disableTreadmillQuery(instance)
        if instance:IsA("BasePart") then
            instance.CanQuery = false
        end
    end

    local treadmillFolder = Workspace:WaitForChild("__ClientTreadmillRenders", 5)
    if treadmillFolder then
        for _, part in ipairs(treadmillFolder:GetDescendants()) do
            disableTreadmillQuery(part)
        end
        treadmillFolder.DescendantAdded:Connect(disableTreadmillQuery)
    end

    Workspace.ChildAdded:Connect(function(child)
        if child.Name == "__ClientTreadmillRenders" then
            for _, part in ipairs(child:GetDescendants()) do
                disableTreadmillQuery(part)
            end
            child.DescendantAdded:Connect(disableTreadmillQuery)
        end
    end)
end)

