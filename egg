local function SaveConfig()
    if writefile then
        local dataToSave = {
            MoveMode = Config.MoveMode,
            FlySpeed = Config.FlySpeed,
            FlyHeight = Config.FlyHeight,
            TitanWeight = Config.TitanWeight,
            BarrierDelay = Config.BarrierDelay,
            Rarities = Config.Rarities
        }
        pcall(function()
            writefile(ConfigFile, HttpService:JSONEncode(dataToSave))
        end)
    end
end

local function LoadConfig()
    if readfile and isfile and isfile(ConfigFile) then
        pcall(function()
            local raw = readfile(ConfigFile)
            local decoded = HttpService:JSONDecode(raw)
            if decoded then
                if decoded.MoveMode then Config.MoveMode = decoded.MoveMode end
                if decoded.FlySpeed then Config.FlySpeed = decoded.FlySpeed end
                if decoded.FlyHeight then Config.FlyHeight = decoded.FlyHeight end
                if decoded.TitanWeight then Config.TitanWeight = decoded.TitanWeight end
                if decoded.BarrierDelay then Config.BarrierDelay = decoded.BarrierDelay end
                if decoded.Rarities then
                    for k, v in pairs(decoded.Rarities) do
                        if Config.Rarities[k] ~= nil then
                            Config.Rarities[k] = v
                        end
                    end
                end
            end
        end)
    end
end

