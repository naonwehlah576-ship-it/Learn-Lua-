local function FormatKg(num)
    if num >= 1000000 then
        return string.format("%.2fM Kg", num / 1000000)
    elseif num >= 1000 then
        return string.format("%.1fK Kg", num / 1000)
    else
        return string.format("%.2f Kg", num)
    end
end

