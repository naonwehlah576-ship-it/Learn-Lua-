-- ==========================================
-- AUTO STEAL LOGIC
-- ==========================================
local function GetRarity(category)
    local assetData = AssetsDirectory.Directory and AssetsDirectory.Directory[category]
    if assetData and assetData.Rarity then
        return typeof(assetData.Rarity) == "table" and (assetData.Rarity.Name or assetData.Rarity.DisplayName) or tostring(assetData.Rarity)
    end
    return "Unknown"
end

local function GetTargetEgg()
    local snapshot = EggCmds.RequestAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil end
    
    for _, record in ipairs(snapshot.Records) do
        if record.State == "Slot" or record.State == "Dropped" then
            local category = record.AssetCategory or "Unknown"
            local rarity = GetRarity(category)
            
            if Config.Rarities[rarity] and record.BottomCFrame then
                return record
            end
        end
    end
    return nil
end

local function ClaimSafeZone()
    UpdateStatus("Reset Posisi & Klaim di Safe Area")
    TweenTo(Config.SafeArea, false)
    task.wait(1)
end

task.spawn(function()
    while task.wait(0.5) do
        if not Config.AutoSteal then
            UpdateStatus("Idle (Off)")
            ToggleNoclip(false)
            continue 
        end
        
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        
        local currentPos = char.HumanoidRootPart.Position
        
        UpdateStatus("Mencari Telur...")
        
        if (currentPos - Config.SafeArea).Magnitude > 10 then
            UpdateStatus("Kembali ke Safe Area...")
            TweenTo(Vector3.new(currentPos.X, Config.HoverY, currentPos.Z), true)
            TweenTo(Vector3.new(Config.SafeArea.X, Config.HoverY, Config.SafeArea.Z), true)
            TweenTo(Config.SafeArea, false)
        end
        
        local targetEgg = GetTargetEgg()
        if targetEgg then
            local eggPos = targetEgg.BottomCFrame.Position
            
            UpdateStatus("Berangkat lewat Y=72...")
            TweenTo(Vector3.new(Config.SafeArea.X, Config.HoverY, Config.SafeArea.Z), true) 
            TweenTo(Vector3.new(eggPos.X, Config.HoverY, eggPos.Z), true) 
            
            UpdateStatus("Turun ke posisi telur...")
            TweenTo(eggPos, true) 
            
            task.wait(0.3) 
            
            -- [DIPERBAIKI] Remote Steal Bypass
            UpdateStatus("Eksekusi Mencuri Telur!")
            local slotKey = nil
            if AreaEggSlotIdentity.IsFirstAreaUid(targetEgg.Uid) then
                slotKey = AreaEggSlotIdentity.BuildSlotKey(targetEgg.AreaId, targetEgg.NestId)
            end
            
            pcall(function()
                EggCmds.RequestCarryAreaEgg(targetEgg.Uid, slotKey) 
            end)
            
            task.wait(0.5)
            
            UpdateStatus("Membawa telur pulang...")
            local posAfterSteal = char.HumanoidRootPart.Position
            TweenTo(Vector3.new(posAfterSteal.X, Config.HoverY, posAfterSteal.Z), true) 
            TweenTo(Vector3.new(Config.SafeArea.X, Config.HoverY, Config.SafeArea.Z), true) 
            
            ClaimSafeZone()
        end
    end
end)
