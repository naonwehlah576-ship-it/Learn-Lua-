local ConfigFile = "AutoSteal_Config.json"

local Config = {
    Enabled = false,
    FlySpeed = 65,
    FlyHeight = 75, -- Ketinggian terbang umum
    SafeArea = Vector3.new(540.1, 71.4, -369.1),
    Rarities = {
        Common = false,
        Uncommon = false,
        Rare = false,
        Epic = false,
        Legendary = false,
        Mythic = false,
        Secret = true,
        Divine = true,
        Eternal = true
    }
}

local function SaveConfig()
    if writefile then
        local dataToSave = {
            FlySpeed = Config.FlySpeed,
            FlyHeight = Config.FlyHeight,
            Rarities = Config.Rarities
        }
        pcall(function()
            writefile(ConfigFile, HttpService:JSONEncode(dataToSave))
        end)
    end
end

local function LoadConfig()
    if readfile and isfile and isfile(ConfigFile) then
        pcall(function()
            local raw = readfile(ConfigFile)
            local decoded = HttpService:JSONDecode(raw)
            if decoded then
                if decoded.FlySpeed then Config.FlySpeed = decoded.FlySpeed end
                if decoded.FlyHeight then 
                    Config.FlyHeight = decoded.FlyHeight 
                elseif decoded.HoverY then
                    Config.FlyHeight = decoded.HoverY
                end
                if decoded.Rarities then
                    for k, v in pairs(decoded.Rarities) do
                        if Config.Rarities[k] ~= nil then
                            Config.Rarities[k] = v
                        end
                    end
                end
            end
        end)
    end
end

LoadConfig()

