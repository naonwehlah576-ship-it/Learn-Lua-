-- ==========================================
-- MAIN AUTOMATION LOOP
-- ==========================================
task.spawn(function()
    while task.wait(0.2) do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if not Config.Enabled or not hrp or not humanoid or humanoid.Health <= 0 then
            ToggleNoclip(false)
            continue
        end

        local targetEgg = GetBestTargetEgg()
        
        if targetEgg then
            ToggleNoclip(true)

            local safePos = Config.SafeArea
            local hoverSafePos = Vector3.new(safePos.X, Config.HoverY, safePos.Z)

            local eggPos = targetEgg.BottomCFrame.Position
            local hoverEggPos = Vector3.new(eggPos.X, Config.HoverY, eggPos.Z)

            -- 1. PASTIKAN MULAI DARI SAFE AREA
            local distToSafe = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(safePos.X, 0, safePos.Z)).Magnitude
            if distToSafe > 5 then
                if not SmoothFly(Vector3.new(hrp.Position.X, Config.HoverY, hrp.Position.Z)) then continue end
                if not SmoothFly(hoverSafePos) then continue end
                if not SmoothFly(safePos) then continue end
            end

            -- 2. BERANGKAT MELUNCUR KE ATAS TELUR (Hover)
            if not SmoothFly(hoverSafePos) then continue end
            if not SmoothFly(hoverEggPos) then continue end
            
            -- 3. TURUN KE POSISI TELUR DENGAN OFFSET Y +3.5 STUD
            local landEggPos = eggPos + Vector3.new(0, 3.5, 0)
            if not SmoothFly(landEggPos) then continue end

            -- 4. MENDARAT & RESET VELOCITY
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.25)

            -- Verifikasi ketersediaan telur
            local snapshot = EggCmds.RequestAreaEggSnapshot()
            local eggStillValid = false
            if snapshot and snapshot.Records then
                for _, rec in ipairs(snapshot.Records) do
                    if rec.Uid == targetEgg.Uid and (rec.State == "Slot" or rec.State == "Dropped") then
                        eggStillValid = true
                        break
                    end
                end
            end

            if eggStillValid then
                local slotKey = nil
                if AreaEggSlotIdentity.IsFirstAreaUid(targetEgg.Uid) then
                    slotKey = AreaEggSlotIdentity.BuildSlotKey(targetEgg.AreaId, targetEgg.NestId)
                end
                
                pcall(function()
                    EggCmds.RequestCarryAreaEgg(targetEgg.Uid, slotKey)
                end)
            end

            -- 5. KEMBALI KE SAFE AREA DENGAN RETURN HOVER Y
            local returnHoverEggPos = Vector3.new(eggPos.X, Config.ReturnHoverY, eggPos.Z)
            local returnHoverSafePos = Vector3.new(safePos.X, Config.ReturnHoverY, safePos.Z)

            if not SmoothFly(returnHoverEggPos) then continue end
            if not SmoothFly(returnHoverSafePos) then continue end
            if not SmoothFly(safePos) then continue end

            -- 6. CLAIM SELESAI DI SAFE AREA
            ToggleNoclip(false)
            task.wait(1.5)
        else
            -- Status idle: kembali ke safe area jika di luar titik aman
            local distToSafe = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(Config.SafeArea.X, 0, Config.SafeArea.Z)).Magnitude
            if distToSafe > 5 then
                ToggleNoclip(true)
                SmoothFly(Vector3.new(hrp.Position.X, Config.HoverY, hrp.Position.Z))
                SmoothFly(Vector3.new(Config.SafeArea.X, Config.HoverY, Config.SafeArea.Z))
                SmoothFly(Config.SafeArea)
                ToggleNoclip(false)
            end
        end
    end
end)
