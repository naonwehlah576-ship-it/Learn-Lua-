-- ==========================================
-- NOCLIP SYSTEM & ANTI-FALL
-- ==========================================
local noclipConnection
local function ToggleNoclip(state)
    local char = LocalPlayer.Character
    if not char then return end
    
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function SetupHumanoid(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end
end

if LocalPlayer.Character then SetupHumanoid(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(SetupHumanoid)

-- ==========================================
-- LERP FLIGHT ENGINE (ZERO-GRAVITY DIPPING + BYPASS)
-- ==========================================
local function SmoothFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    local currentSpeed = speed or Config.FlySpeed
    local startPos = hrp.Position
    local totalDistance = (targetPos - startPos).Magnitude

    if totalDistance < 0.5 then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    local duration = totalDistance / currentSpeed
    local elapsed = 0
    local direction = (targetPos - startPos).Unit

    -- Mengunci ragdoll/kaki agar tidak terpengaruh animasi jatuh Roblox
    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)

    while elapsed < duration and Config.Enabled and hum.Health > 0 do
        local dt = RunService.PreSimulation:Wait()
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then 
            if hum then hum.PlatformStand = false end
            return false 
        end

        elapsed = math.min(elapsed + dt, duration)
        local alpha = elapsed / duration
        
        -- KALKULASI GARIS LURUS MURNI (Tidak terpengaruh gravitasi sama sekali)
        local calculatedPos = startPos:Lerp(targetPos, alpha)

        -- Velocity Synchronization untuk Anti-Cheat
        hrp.AssemblyLinearVelocity = direction * currentSpeed
        hrp.AssemblyAngularVelocity = Vector3.zero

        if direction.Magnitude > 0.001 then
            hrp.CFrame = CFrame.new(calculatedPos, calculatedPos + direction)
        else
            hrp.CFrame = CFrame.new(calculatedPos)
        end
    end

    if hrp then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    
    if hum then
        hum.PlatformStand = false
    end

    return Config.Enabled and (hum and hum.Health > 0)
end

-- ==========================================
-- LOGIC DETEKSI TELUR
-- ==========================================
local function GetRarityText(category)
    local assetData = AssetsDirectory.Directory and AssetsDirectory.Directory[category]
    if assetData and assetData.Rarity then
        return typeof(assetData.Rarity) == "table" and (assetData.Rarity.Name or assetData.Rarity.DisplayName) or tostring(assetData.Rarity)
    end
    return "Unknown"
end

local function GetBestTargetEgg()
    local snapshot = EggCmds.RequestAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil end

    local now = tick()
    local bestEgg = nil
    for _, record in ipairs(snapshot.Records) do
        if not IgnoredEggs[record.Uid] or now > IgnoredEggs[record.Uid] then
            if record.State == "Slot" or record.State == "Dropped" then
                local rarity = GetRarityText(record.AssetCategory)
                if Config.Rarities[rarity] and record.BottomCFrame then
                    bestEgg = record
                    break
                end
            end
        end
    end
    return bestEgg
end

