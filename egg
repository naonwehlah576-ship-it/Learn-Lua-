-- ==========================================
local ConfigFile = "AutoSteal_Config.json"

local Config = {
    Enabled = false,
    FlySpeed = 65,
    HoverY = 75,
    ReturnHoverY = 100,
    SafeArea = Vector3.new(540.1, 71.4, -369.1),
    Rarities = {
        Common = false,
        Uncommon = false,
        Rare = false,
        Epic = false,
        Legendary = false,
        Mythic = false,
        Secret = true,
        Divine = true,
        Eternal = true
    }
}

local function SaveConfig()
    if writefile then
        local dataToSave = {
            FlySpeed = Config.FlySpeed,
            HoverY = Config.HoverY,
            ReturnHoverY = Config.ReturnHoverY,
            Rarities = Config.Rarities
        }
        pcall(function()
            writefile(ConfigFile, HttpService:JSONEncode(dataToSave))
        end)
    end
end

local function LoadConfig()
    if readfile and isfile and isfile(ConfigFile) then
        pcall(function()
            local raw = readfile(ConfigFile)
            local decoded = HttpService:JSONDecode(raw)
            if decoded then
                if decoded.FlySpeed then Config.FlySpeed = decoded.FlySpeed end
                if decoded.HoverY then Config.HoverY = decoded.HoverY end
                if decoded.ReturnHoverY then Config.ReturnHoverY = decoded.ReturnHoverY end
                if decoded.Rarities then
                    for k, v in pairs(decoded.Rarities) do
                        if Config.Rarities[k] ~= nil then
                            Config.Rarities[k] = v
                        end
                    end
                end
            end
        end)
    end
end

LoadConfig()

-- ==========================================
-- NOCLIP SYSTEM
-- ==========================================
local noclipConnection
local function ToggleNoclip(state)
    local char = LocalPlayer.Character
    if not char then return end
    
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- ==========================================
-- SMOOTH FLIGHT ENGINE (PENGGANTI TWEEN & ANCHOR)
-- ==========================================
local function SmoothFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    local currentSpeed = speed or Config.FlySpeed

    while Config.Enabled and hum.Health > 0 do
        local dt = RunService.Heartbeat:Wait()
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return false end

        -- Matikan physics falling / terlempar
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local currentPos = hrp.Position
        local delta = targetPos - currentPos
        local distance = delta.Magnitude

        local step = currentSpeed * dt

        if distance <= step or distance < 0.5 then
            hrp.CFrame = CFrame.new(targetPos)
            break
        else
            local nextPos = currentPos + (delta.Unit * step)
            hrp.CFrame = CFrame.new(nextPos)
        end
    end

    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    return Config.Enabled and (hum and hum.Health > 0)
end

-- ==========================================
-- LOGIC DETEKSI TELUR (PERSIS DARI SKRIP KAMU)
-- ==========================================
local function GetRarityText(category)
    local assetData = AssetsDirectory.Directory and AssetsDirectory.Directory[category]
    if assetData and assetData.Rarity then
        return typeof(assetData.Rarity) == "table" and (assetData.Rarity.Name or assetData.Rarity.DisplayName) or tostring(assetData.Rarity)
    end
    return "Unknown"
end

local function GetBestTargetEgg()
    local snapshot = EggCmds.RequestAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil end

    local bestEgg = nil
    for _, record in ipairs(snapshot.Records) do
        if record.State == "Slot" or record.State == "Dropped" then
            local rarity = GetRarityText(record.AssetCategory)
            if Config.Rarities[rarity] and record.BottomCFrame then
                bestEgg = record
                break
            end
        end
    end
    return bestEgg
end

