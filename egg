-- ==========================================
-- MOVEMENT ENGINE: 1. TRUE WALK DENGAN REM CAKRAM AKTIF
-- ==========================================
local function TrueWalkTo(targetPos, timeout)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.Running)
    ToggleNoclip(false)

    local maxTime = timeout or 20
    local startTime = tick()
    local stuckTimer = 0

    while Config.Enabled and hum.Health > 0 and (tick() - startTime < maxTime) do
        local dt = RunService.Heartbeat:Wait()
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return false end

        local curPos = hrp.Position
        local delta2D = Vector3.new(targetPos.X - curPos.X, 0, targetPos.Z - curPos.Z)
        local distance2D = delta2D.Magnitude

        -- 🛑 REM CAKRAM AKTIF: Berhenti mendadak tanpa bablas/melengpeng
        if distance2D <= 4.5 then
            hum:Move(Vector3.zero)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(targetPos.X, curPos.Y, targetPos.Z)
            task.wait(0.05)
            hrp.AssemblyLinearVelocity = Vector3.zero
            return true
        end

        hum:MoveTo(targetPos)

        -- Anti-Nyangkut (Auto Jump jika terhalang)
        local velocity2D = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude
        if velocity2D < 5 and distance2D > 6 then
            stuckTimer = stuckTimer + dt
            if stuckTimer > 0.3 then
                hum.Jump = true
                stuckTimer = 0
            end
        else
            stuckTimer = 0
        end

        -- Batal jika malam tiba
        if CheckIsServerNight() or not IsBarrierOpen then
            hum:Move(Vector3.zero)
            hrp.AssemblyLinearVelocity = Vector3.zero
            return false
        end
    end

    if hum then hum:Move(Vector3.zero) end
    if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    return Config.Enabled and (hum and hum.Health > 0)
end

-- ==========================================
-- MOVEMENT ENGINE: 2. PURE CFRAME FLY (HEARTBEAT)
-- ==========================================
local function PureCFrameFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    local currentSpeed = speed or Config.FlySpeed
    local startPos = hrp.Position
    local dist = (targetPos - startPos).Magnitude
    local duration = dist / currentSpeed
    local elapsed = 0

    while elapsed < duration and Config.Enabled and hum.Health > 0 do
        local dt = RunService.Heartbeat:Wait()
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return false end

        elapsed = elapsed + dt
        local alpha = math.min(elapsed / duration, 1)
        local curPos = startPos:Lerp(targetPos, alpha)
        hrp.CFrame = CFrame.new(curPos)
    end

    if hrp then
        hrp.CFrame = CFrame.new(targetPos)
    end

    return Config.Enabled and (hum and hum.Health > 0)
end

-- ==========================================
-- LOGIC DETEKSI & TITAN-WEIGHT MULTI-TIER
-- ==========================================
local function GetRarityText(category)
    local assetData = AssetsDirectory.Directory and AssetsDirectory.Directory[category]
    if assetData and assetData.Rarity then
        return typeof(assetData.Rarity) == "table" and (assetData.Rarity.Name or assetData.Rarity.DisplayName) or tostring(assetData.Rarity)
    end
    return "Unknown"
end

local function GetTargetScore(candidate)
    local rarity = candidate.Rarity
    local weight = candidate.WeightKg

    if rarity == "Divine" then
        return 4, weight
    elseif rarity == "Eternal" then
        return 3, weight
    elseif weight >= Config.TitanWeight and Config.TitanWeight > 0 then
        return 2, weight
    elseif Config.Rarities[rarity] then
        local rank = RarityPriority[rarity] or 0
        return 1, rank, weight
    end

    return 0, 0, 0
end

local function GetBestTargetEgg()
    local snapshot = EggCmds.RequestAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Config.SafeArea

    local now = tick()
    local candidates = {}

    for _, record in ipairs(snapshot.Records) do
        if not IgnoredEggs[record.Uid] or now > IgnoredEggs[record.Uid] then
            if (record.State == "Slot" or record.State == "Dropped") and record.BottomCFrame then
                local category = tostring(record.AssetCategory or "Unknown")
                local rarity = GetRarityText(category)
                local scale = tonumber(record.AssetScale) or 1
                
                local weightKg = 0
                local success, res = pcall(function()
                    return EggItemUtil.GetWeightKgForScale(category, scale)
                end)
                if success and tonumber(res) then weightKg = res end

                local eggPos = record.BottomCFrame.Position
                local distance = (eggPos - myPos).Magnitude

                local cand = {
                    Record = record,
                    Rarity = rarity,
                    Category = category,
                    WeightKg = weightKg,
                    Distance = distance
                }

                local tier = GetTargetScore(cand)
                if tier > 0 then
                    table.insert(candidates, cand)
                end
            end
        end
    end

    if #candidates == 0 then return nil end

    -- MULTI-TIER SMART SORTING
    table.sort(candidates, function(a, b)
        local tierA, valA1 = GetTargetScore(a)
        local tierB, valB1 = GetTargetScore(b)

        if tierA ~= tierB then
            return tierA > tierB
        end

        if tierA == 4 or tierA == 3 or tierA == 2 then
            if a.WeightKg ~= b.WeightKg then
                return a.WeightKg > b.WeightKg
            else
                return a.Distance < b.Distance
            end
        elseif tierA == 1 then
            if valA1 ~= valB1 then
                return valA1 > valB1
            elseif a.WeightKg ~= b.WeightKg then
                return a.WeightKg > b.WeightKg
            else
                return a.Distance < b.Distance
            end
        end
        return false
    end)

    return candidates[1]
end

