        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    
    SetStatus("FORCE STOPPED / RESET")
end

-- ==========================================
-- LERP FLIGHT ENGINE (ZERO SAG & BYPASS)
-- ==========================================
local function SmoothFly(targetPos, speed)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    local currentSpeed = speed or Config.FlySpeed
    local startPos = hrp.Position
    local totalDistance = (targetPos - startPos).Magnitude

    if totalDistance < 0.5 then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end

    local duration = totalDistance / currentSpeed
    local elapsed = 0
    local direction = (targetPos - startPos).Unit

    hum.PlatformStand = true
    hum:ChangeState(Enum.HumanoidStateType.Physics)

    while elapsed < duration and Config.Enabled and hum.Health > 0 do
        local dt = RunService.PreSimulation:Wait()
        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then 
            if hum then hum.PlatformStand = false end
            return false 
        end

        elapsed = math.min(elapsed + dt, duration)
        local alpha = elapsed / duration
        
        local calculatedPos = startPos:Lerp(targetPos, alpha)

        hrp.AssemblyLinearVelocity = direction * currentSpeed
        hrp.AssemblyAngularVelocity = Vector3.zero

        if direction.Magnitude > 0.001 then
            hrp.CFrame = CFrame.new(calculatedPos, calculatedPos + direction)
        else
            hrp.CFrame = CFrame.new(calculatedPos)
        end
    end

    if hrp then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    
    if hum then
        hum.PlatformStand = false
    end

    return Config.Enabled and (hum and hum.Health > 0)
end

-- ==========================================
-- LOGIC DETEKSI & SMART PRIORITY SELECTION
-- ==========================================
local function GetRarityText(category)
    local assetData = AssetsDirectory.Directory and AssetsDirectory.Directory[category]
    if assetData and assetData.Rarity then
        return typeof(assetData.Rarity) == "table" and (assetData.Rarity.Name or assetData.Rarity.DisplayName) or tostring(assetData.Rarity)
    end
    return "Unknown"
end

local function GetBestTargetEgg()
    local snapshot = EggCmds.RequestAreaEggSnapshot()
    if not snapshot or not snapshot.Records then return nil end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Config.SafeArea

    local now = tick()
    local candidates = {}

    -- Kumpulkan semua telur yang sesuai filter dan tidak cooldown
    for _, record in ipairs(snapshot.Records) do
        if not IgnoredEggs[record.Uid] or now > IgnoredEggs[record.Uid] then
            if record.State == "Slot" or record.State == "Dropped" then
                local rarity = GetRarityText(record.AssetCategory)
                if Config.Rarities[rarity] and record.BottomCFrame then
                    local eggPos = record.BottomCFrame.Position
                    local distance = (eggPos - myPos).Magnitude
                    local priorityScore = RarityPriority[rarity] or 0

                    table.insert(candidates, {
                        Record = record,
                        Rarity = rarity,
                        Priority = priorityScore,
                        Distance = distance
                    })
                end
            end
        end
    end

    if #candidates == 0 then return nil end

    -- SORTING CERDAS: 
    -- 1. Utamakan Rarity Tertinggi (Priority Terbesar)
    -- 2. Jika Rarity sama, pilih Jarak Terdekat (Distance Terkecil)
    table.sort(candidates, function(a, b)
        if a.Priority ~= b.Priority then
            return a.Priority > b.Priority
        else
            return a.Distance < b.Distance
        end
    end)

    return candidates[1].Record
end

