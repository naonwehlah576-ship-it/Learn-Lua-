-- ==========================================
-- MAIN AUTOMATION LOOP
-- ==========================================
task.spawn(function()
    while task.wait(0.2) do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if not Config.Enabled or not hrp or not humanoid or humanoid.Health <= 0 then
            ToggleNoclip(false)
            continue
        end

        local targetEgg = GetBestTargetEgg()
        
        if targetEgg then
            local eggRarity = GetRarityText(targetEgg.AssetCategory)
            local carriedSuccessfully = false

            SetStatus("Target: [" .. eggRarity .. "]...")
            ToggleNoclip(true)

            local safePos = Config.SafeArea
            local flySafePos = Vector3.new(safePos.X, Config.FlyHeight, safePos.Z)

            local eggPos = targetEgg.BottomCFrame.Position
            local flyEggPos = Vector3.new(eggPos.X, Config.FlyHeight, eggPos.Z)

            -- 1. PASTIKAN MULAI DARI TITIK AMAN
            local distToSafe = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(safePos.X, 0, safePos.Z)).Magnitude
            if distToSafe > 5 then
                if not SmoothFly(Vector3.new(hrp.Position.X, Config.FlyHeight, hrp.Position.Z)) then continue end
                if not SmoothFly(flySafePos) then continue end
                if not SmoothFly(safePos) then continue end
            end

            -- 2. TERBANG MENUJU TITIK DI ATAS TELUR
            if not SmoothFly(flySafePos) then continue end
            if not SmoothFly(flyEggPos) then continue end
            
            -- 3. TURUN KE POSISI TELUR
            SetStatus("Mengambil [" .. eggRarity .. "]...")
            local landEggPos = eggPos + Vector3.new(0, 3.5, 0)
            if not SmoothFly(landEggPos) then continue end

            -- 4. MENDARAT & AMBIL TELUR
            ToggleNoclip(false)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.25)

            -- Verifikasi ketersediaan telur di sarang
            local snapshot = EggCmds.RequestAreaEggSnapshot()
            local eggStillValid = false
            if snapshot and snapshot.Records then
                for _, rec in ipairs(snapshot.Records) do
                    if rec.Uid == targetEgg.Uid and (rec.State == "Slot" or rec.State == "Dropped") then
                        eggStillValid = true
                        break
                    end
                end
            end

            if eggStillValid then
                local slotKey = nil
                if AreaEggSlotIdentity.IsFirstAreaUid(targetEgg.Uid) then
                    slotKey = AreaEggSlotIdentity.BuildSlotKey(targetEgg.AreaId, targetEgg.NestId)
                end
                
                local success = pcall(function()
                    EggCmds.RequestCarryAreaEgg(targetEgg.Uid, slotKey)
                end)
                
                if success then
                    carriedSuccessfully = true
                end
            end
            
            -- Blacklist UID agar tidak ditarget ulang
            IgnoredEggs[targetEgg.Uid] = tick() + 10

            -- 5. TERBANG PULANG KE SAFE AREA
            SetStatus("Membawa [" .. eggRarity .. "] Pulang...")
            ToggleNoclip(true)
            if not SmoothFly(flyEggPos) then continue end
            if not SmoothFly(flySafePos) then continue end
            if not SmoothFly(safePos) then continue end

            -- 6. VERIFIKASI CLAIM HANYA JIKA BAWA TELUR
            ToggleNoclip(false)
            
            if carriedSuccessfully then
                SetStatus("Claiming [" .. eggRarity .. "]...")
                JustClaimed = false
                local claimStart = tick()
                
                while not JustClaimed and (tick() - claimStart < 2.0) and Config.Enabled do
                    task.wait(0.1)
                end
                
                EggsStolenCount = EggsStolenCount + 1
                UpdateCounterDisplay()
                SetStatus("Sukses Curi [" .. eggRarity .. "]! (+1)")
                task.wait(0.5)
            else
                SetStatus("Telur Gagal / Keduluan...")
                task.wait(0.3)
            end
            
            SetStatus("Standby / Mencari Telur...")
        else
            -- Status Idle
            SetStatus("Mencari Telur...")
            local distToSafe = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(Config.SafeArea.X, 0, Config.SafeArea.Z)).Magnitude
            if distToSafe > 5 then
                ToggleNoclip(true)
                SmoothFly(Vector3.new(hrp.Position.X, Config.FlyHeight, hrp.Position.Z))
                SmoothFly(Vector3.new(Config.SafeArea.X, Config.FlyHeight, Config.SafeArea.Z))
                SmoothFly(Config.SafeArea)
                ToggleNoclip(false)
            end
        end
    end
end)
